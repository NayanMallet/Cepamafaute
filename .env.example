# Copier en .env (jamais commité) : cp .env.example .env
# Docker Compose lit ce fichier automatiquement et remplace les ${VARIABLE} du docker-compose.yml.

# --- IA (backend) ---
# Sans clé, le backend répond avec des phrases corporate locales (mode fallback).
AI_API_KEY=
# Endpoint au format OpenAI "chat completions" (Groq : offre gratuite)
AI_API_URL=https://api.groq.com/openai/v1/chat/completions
AI_MODEL=qwen/qwen3.8-27b
# Doit rester sous les 10 s du "docker stop"
AI_TIMEOUT_MS=8000

# --- Port exposé sur la machine hôte ---
PROXY_PORT=8080

# --- Ressources allouées à chaque conteneur ---
BACKEND_CPUS=0.50
BACKEND_MEMORY=128M
FRONTEND_CPUS=0.20
FRONTEND_MEMORY=64M
PROXY_CPUS=0.20
PROXY_MEMORY=64M
LINT_CPUS=0.50
LINT_MEMORY=256M
TEST_CPUS=0.50
TEST_MEMORY=256M
